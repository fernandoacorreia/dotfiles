#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["pyarrow"]
# ///
"""
Converts a Parquet file to pretty-printed JSON.

Given a file name, writes a sibling .json file and prints its path. Reading
from stdin (no argument, or "-") writes the JSON to stdout instead.

    parquet2json data.parquet     # writes data.json
    cat data.parquet | parquet2json
"""
import io
import json
import sys
from datetime import date, datetime, time, timedelta
from decimal import Decimal
from pathlib import Path

import pyarrow.parquet as pq


def encode(value):
    """Render values that json.dumps can't handle natively."""
    if isinstance(value, (datetime, date, time)):
        return value.isoformat()
    if isinstance(value, timedelta):
        return str(value)
    if isinstance(value, Decimal):
        return float(value)
    if isinstance(value, (bytes, bytearray, memoryview)):
        return bytes(value).hex()
    raise TypeError(f"cannot serialize {type(value).__name__}")


def main():
    args = sys.argv[1:]
    if len(args) > 1:
        sys.exit("usage: parquet2json [FILE]")

    if not args or args[0] == "-":
        # pyarrow needs a seekable source, which a pipe isn't.
        source = io.BytesIO(sys.stdin.buffer.read())
        destination = None
    else:
        source = Path(args[0])
        destination = source.with_suffix(".json")
        if destination == source:
            sys.exit(f"parquet2json: {source} is already a .json file")

    try:
        table = pq.read_table(source)
    except Exception as e:
        sys.exit(f"parquet2json: {e}")

    records = table.to_pylist()
    if destination is None:
        json.dump(records, sys.stdout, indent=2, default=encode)
        sys.stdout.write("\n")
    else:
        with destination.open("w") as f:
            json.dump(records, f, indent=2, default=encode)
            f.write("\n")
        print(destination)


if __name__ == "__main__":
    main()
