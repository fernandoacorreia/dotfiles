#!/bin/bash
#
# Alerts when backup-chrome-tabs stops reporting, or keeps reporting but stops
# producing backups. Designed to run as a scheduled/background task — output is
# logged.
#
set -o nounset -o pipefail

JOB_MARKER="$HOME/.local/state/backup-chrome-tabs.last-run"
JOB_SUCCESS_MARKER="$HOME/.local/state/backup-chrome-tabs.last-success"
LOG_DIR="$HOME/.local/log"
LOG_FILE="$LOG_DIR/check-chrome-tabs-backup.log"

# backup-chrome-tabs runs hourly. Its LaunchAgent runs a missed interval when the
# machine wakes, so a stale marker means the job is broken rather than that the
# machine slept — no sleep-gap heuristic is needed here.
JOB_STALE_AFTER=10800
SUCCESS_STALE_AFTER=86400

NOW="$(date '+%s')"

timestamp() {
  date '+%Y-%m-%d %H:%M:%S'
}

log() {
  if ! echo "[$(timestamp)] $*" >> "$LOG_FILE" 2>/dev/null; then
    echo "check-chrome-tabs-backup: cannot write $LOG_FILE: $*" >&2
  fi
}

notify() {
  osascript -e 'on run argv
display notification (item 1 of argv) with title "backup-chrome-tabs needs attention"
end run' "$1" >/dev/null 2>&1 \
    || log "ERROR: notifier exited non-zero — notification may not have been delivered"
}

fail() {
  log "FAIL: $1"
  notify "$1"
  log ""
  exit 1
}

if ! mkdir -p "$LOG_DIR"; then
  echo "check-chrome-tabs-backup: cannot create $LOG_DIR" >&2
  exit 1
fi

log "=== Starting check-chrome-tabs-backup ==="

# The backup agent sets RunAtLoad, so a marker exists from the moment it is loaded.
# An absent marker therefore means the job is not installed or cannot write, not
# that it simply has not run yet.
[[ -e "$JOB_MARKER" ]] || fail "has never reported — run marker is missing"
[[ -r "$JOB_MARKER" ]] || fail "run marker exists but is unreadable"

JOB_EPOCH=""
JOB_OUTCOME=""
read -r JOB_EPOCH JOB_OUTCOME _ < "$JOB_MARKER" || true

[[ "$JOB_EPOCH" =~ ^[0-9]+$ ]] || fail "run marker is malformed — expected an epoch, found '$JOB_EPOCH'"
[[ "$JOB_OUTCOME" =~ ^(ok|skip|fail)$ ]] || fail "run marker has an unrecognised outcome '$JOB_OUTCOME'"

JOB_AGE=$(( NOW - JOB_EPOCH ))
(( JOB_AGE >= 0 )) || fail "run marker is dated in the future — clock or marker corruption"
(( JOB_AGE <= JOB_STALE_AFTER )) || fail "has not reported for $(( JOB_AGE / 3600 ))h"

# A fresh marker only proves the script ran, not that it produced anything. Check
# the last success regardless of the latest outcome: a permanent run of `skip` (say,
# the pgrep guard stops matching after a Chrome rename) hides a dead job just as
# effectively as a run of `fail`.
SUCCESS_AGE=""
if [[ -r "$JOB_SUCCESS_MARKER" ]]; then
  SUCCESS_EPOCH=""
  read -r SUCCESS_EPOCH _ < "$JOB_SUCCESS_MARKER" || true
  if [[ "$SUCCESS_EPOCH" =~ ^[0-9]+$ ]]; then
    SUCCESS_AGE=$(( NOW - SUCCESS_EPOCH ))
    (( SUCCESS_AGE >= 0 )) || fail "success marker is dated in the future — clock or marker corruption"
  fi
fi

# Gate on Chrome actually running, so a legitimately Chrome-free stretch stays quiet.
# Chrome running plus no successful backup is unambiguously wrong.
CHROME_RUNNING=no
if pgrep -U "$(id -u)" -x "Google Chrome" >/dev/null; then
  CHROME_RUNNING=yes
fi

if [[ "$CHROME_RUNNING" == "yes" ]]; then
  if [[ -z "$SUCCESS_AGE" ]]; then
    fail "Chrome is running but no backup has ever succeeded"
  fi
  if (( SUCCESS_AGE > SUCCESS_STALE_AFTER )); then
    fail "Chrome is running but no backup has succeeded for $(( SUCCESS_AGE / 3600 ))h"
  fi
fi

log "OK: reported ${JOB_AGE}s ago (outcome: $JOB_OUTCOME), Chrome running: $CHROME_RUNNING"
log ""
