#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.9"
# dependencies = []
# ///
"""
Shows pod status, same as `kubectl get pods`, plus a CONTAINERS column
listing each container as "<name>:<image-tag>:<status>" (tag defaults to
"latest" when the image has no explicit tag).

An optional bare (non-flag) argument filters the output to pods whose name
starts with it, e.g. `podstatus data-service`.

A `-n`/`--namespace` flag is passed through to `kubectl get pods` and can be
combined with the name filter (`podstatus -n foo api`).
"""
import json
import subprocess
import sys

# The namespace flag consumes a following token as its value, so we don't
# mistake that value for the name-prefix filter (e.g. the "foo" in "-n foo").
VALUE_FLAGS = {"-n", "--namespace"}


def split_args(argv):
    """Split argv into (kubectl flags, name-prefix filter or None)."""
    flags = []
    name_filter = None
    expect_value = False
    for arg in argv:
        if expect_value:
            flags.append(arg)
            expect_value = False
        elif arg.startswith("-"):
            flags.append(arg)
            # "--namespace=foo" is self-contained; "--namespace foo" needs the next token.
            if arg in VALUE_FLAGS and "=" not in arg:
                expect_value = True
        elif name_filter is None:
            name_filter = arg
        else:
            # Extra positionals aren't meaningful here; pass through to kubectl.
            flags.append(arg)
    return flags, name_filter


def image_tag(image):
    """Return the tag portion of a container image, or "latest" if none."""
    # Drop any digest suffix, e.g. repo:tag@sha256:...
    ref = image.split("@", 1)[0]
    # The tag lives in the final path segment, after the last ":".
    last = ref.rsplit("/", 1)[-1]
    if ":" in last:
        return last.rsplit(":", 1)[1]
    return "latest"


def container_summary(pod):
    """Build the "name:status:tag, ..." string for a pod's containers."""
    statuses = {c["name"]: c for c in (pod["status"].get("containerStatuses") or [])}
    parts = []
    for spec in pod["spec"].get("containers", []):
        name = spec["name"]
        cs = statuses.get(name)
        image = (cs or {}).get("image") or spec.get("image", "")
        state = (cs or {}).get("state") or {}
        if "running" in state:
            status = "Running"
        elif "waiting" in state:
            status = state["waiting"].get("reason") or "Waiting"
        elif "terminated" in state:
            status = state["terminated"].get("reason") or "Terminated"
        else:
            status = "Unknown"
        parts.append(f"{name}:{image_tag(image)}:{status}")
    return ", ".join(parts)


def main():
    args, name_filter = split_args(sys.argv[1:])

    table = subprocess.run(
        ["kubectl", "get", "pods", *args], capture_output=True, text=True
    )
    if table.returncode != 0:
        sys.stderr.write(table.stderr)
        sys.exit(table.returncode)

    lines = table.stdout.splitlines()

    # Fetch container details and merge them in. Anything unexpected (non-table
    # output, missing NAME column, JSON errors) falls back to the plain table.
    try:
        result = subprocess.run(
            ["kubectl", "get", "pods", *args, "-o", "json"],
            capture_output=True,
            text=True,
            check=True,
        )
        data = json.loads(result.stdout)

        header = lines[0].split()
        name_idx = header.index("NAME")
        ns_idx = header.index("NAMESPACE") if "NAMESPACE" in header else None

        # Key on (namespace, name) when the table shows namespaces, else on
        # name alone so lookups match regardless of the pod's real namespace.
        summaries = {}
        for pod in data.get("items", []):
            name = pod["metadata"]["name"]
            ns = pod["metadata"].get("namespace")
            key = (ns, name) if ns_idx is not None else name
            summaries[key] = container_summary(pod)

        rows = lines[1:]
        if name_filter is not None:
            rows = [r for r in rows if r.split()[name_idx].startswith(name_filter)]

        width = max(len(line) for line in [lines[0], *rows])
        out = [lines[0].ljust(width) + "   CONTAINERS"]
        for line in rows:
            fields = line.split()
            if ns_idx is not None:
                key = (fields[ns_idx], fields[name_idx])
            else:
                key = fields[name_idx]
            out.append(line.ljust(width) + "   " + summaries.get(key, ""))
        print("\n".join(out))
    except (subprocess.CalledProcessError, json.JSONDecodeError, ValueError, IndexError):
        sys.stdout.write(table.stdout)


if __name__ == "__main__":
    main()
