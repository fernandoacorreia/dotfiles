#!/bin/bash
#
# Converts a Markdown file to PDF.
#
# Uses tectonic as the PDF engine, which downloads LaTeX packages on demand.
# The first run takes a couple of minutes while it builds its format file.
#
# The default Latin Modern font lacks symbols like ✓ ✗ → ★, which are dropped
# with a "could not represent character" warning. For documents that need them,
# pass a font with wider coverage:
#   pandoc input.md --pdf-engine=tectonic -V mainfont="Arial Unicode MS" -o out.pdf
#
# Usage:
#   md-to-pdf input.md [output.pdf]

set -euo pipefail

if [ $# -lt 1 ]; then
  echo "Usage: md-to-pdf input.md [output.pdf]" >&2
  exit 1
fi

input="$1"
output="${2:-${input%.*}.pdf}"

pandoc "$input" \
  --pdf-engine=tectonic \
  --syntax-highlighting=tango \
  --toc \
  -V geometry:margin=1in \
  -o "$output"

echo "Created $output"
