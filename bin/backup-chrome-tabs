#!/bin/bash
#
# Saves all open Google Chrome tabs as a timestamped Markdown file in
# ~/.local/state/chrome-tabs-backups/.
# Designed to run as a scheduled/background task — output is logged.
#
set -o nounset -o pipefail

BACKUP_DIR="$HOME/.local/state/chrome-tabs-backups"
LOG_DIR="$HOME/.local/log"
LOG_FILE="$LOG_DIR/backup-chrome-tabs.log"
MARKER_FILE="$HOME/.local/state/backup-chrome-tabs.last-run"
SUCCESS_MARKER="$HOME/.local/state/backup-chrome-tabs.last-success"

timestamp() {
  date '+%Y-%m-%d %H:%M:%S'
}

log() {
  if ! echo "[$(timestamp)] $*" >> "$LOG_FILE" 2>/dev/null; then
    echo "backup-chrome-tabs: cannot write $LOG_FILE: $*" >&2
  fi
}

# The message is passed through argv rather than interpolated into the
# AppleScript source, because it carries osascript stderr, which can contain
# arbitrary text taken from page titles.
notify() {
  osascript -e 'on run argv
display notification (item 1 of argv) with title "backup-chrome-tabs failed"
end run' "$1" >/dev/null 2>&1 \
    || log "ERROR: notifier exited non-zero — notification may not have been delivered"
}

# Records that the script ran to completion and how it went. The checker needs
# the outcome as well as the time: a run that fails every hour keeps the
# timestamp fresh, so a timestamp alone would look healthy forever.
mark_run() {
  local now
  now="$(date '+%s')"
  write_marker "$MARKER_FILE" "$now $1"
  if [[ "$1" == "ok" ]]; then
    write_marker "$SUCCESS_MARKER" "$now"
  fi
  return 0
}

# Written via temp-and-rename: a plain `>` truncates first, so a failed write would
# leave an empty marker, which the checker cannot tell from a missing one.
write_marker() {
  local file="$1" content="$2"
  if ! (echo "$content" > "$file.tmp" && mv -f "$file.tmp" "$file"); then
    log "ERROR: could not write marker $file"
    rm -f "$file.tmp"
  fi
}

if ! mkdir -p "$LOG_DIR" "$BACKUP_DIR"; then
  echo "backup-chrome-tabs: cannot create $LOG_DIR or $BACKUP_DIR" >&2
  exit 1
fi

log "=== Starting backup-chrome-tabs ==="

# AppleScript's `tell application "Google Chrome"` would launch Chrome if it is
# not running, so guard before reaching the tell block. -x anchors to the exact
# process name so the "Google Chrome Helper" processes don't match, and -U scopes
# the search to this user so another account's Chrome cannot satisfy the guard.
if ! pgrep -U "$(id -u)" -x "Google Chrome" >/dev/null; then
  log "SKIP: Google Chrome is not running"
  mark_run skip
  log ""
  exit 0
fi

TMP_FILE="$(mktemp "$BACKUP_DIR/.tmp.XXXXXX")" || {
  log "FAIL: could not create temp file in $BACKUP_DIR"
  notify "could not create temp file in $BACKUP_DIR"
  mark_run fail
  log ""
  exit 1
}
trap 'rm -f "$TMP_FILE"' EXIT

APPLESCRIPT="$(cat <<'EOT'
set tabList to "# Chrome Tabs Backup" & linefeed & "Generated: " & (current date as string) & linefeed & linefeed
tell application "Google Chrome"
    set windowList to every window
    repeat with aWindow in windowList
        set tabList to tabList & "## Window " & (id of aWindow) & linefeed
        repeat with aTab in tabs of aWindow
            set tTitle to title of aTab
            set tURL to URL of aTab
            -- Format as a Markdown list item with a link
            set tabList to tabList & "- [" & tTitle & "](" & tURL & ")" & linefeed
        end repeat
        set tabList to tabList & linefeed
    end repeat
end tell
return tabList
EOT
)"

# Redirection order is load-bearing: 2>&1 duplicates stderr onto the command
# substitution pipe while stdout is still pointed there, and only then does
# >"$TMP_FILE" move stdout to the file. Reversing them would send the error
# message into the backup instead of capturing it.
if ! OSA_ERR="$(osascript -e "$APPLESCRIPT" 2>&1 >"$TMP_FILE")"; then
  log "FAIL: osascript exited non-zero"
  log "  $OSA_ERR"
  notify "osascript failed: $OSA_ERR"
  mark_run fail
  log ""
  exit 1
fi

if [[ ! -s "$TMP_FILE" ]]; then
  log "FAIL: osascript succeeded but produced no output"
  notify "osascript produced no output"
  mark_run fail
  log ""
  exit 1
fi

# grep exits 1 for "no matches" and >1 for a real error. Collapsing both to 0 would
# turn a grep failure into a silent "no tabs" skip.
count_matches() {
  local pattern="$1" count rc
  count="$(grep -c "$pattern" "$TMP_FILE")"
  rc=$?
  if (( rc > 1 )); then
    return 1
  fi
  echo "$count"
}

if ! WINDOWS="$(count_matches '^## Window ')" || ! TABS="$(count_matches '^- \[')"; then
  log "FAIL: could not count windows or tabs in the captured output"
  notify "could not count windows or tabs in the captured output"
  mark_run fail
  log ""
  exit 1
fi

if (( TABS == 0 )); then
  log "WARN: Chrome is running but reported no tabs — no backup written"
  mark_run skip
  log ""
  exit 0
fi

OUTPUT_FILE="$BACKUP_DIR/chrome_tabs_$(date '+%Y-%m-%d_%H-%M').md"

# Left at mktemp's 0600: these files list every URL in every tab, some carrying
# tokens, and $HOME is group-readable.
# A backup already exists for this minute, so there is nothing to add and nothing
# wrong: RunAtLoad can coincide with a scheduled fire, and manual runs happen. Skip
# rather than overwrite, and stay quiet — this is not a failure.
if [[ -e "$OUTPUT_FILE" ]]; then
  log "SKIP: $(basename "$OUTPUT_FILE") already exists — not overwritten"
  mark_run skip
  log ""
  exit 0
fi

if ! MV_ERR="$(mv -n "$TMP_FILE" "$OUTPUT_FILE" 2>&1)"; then
  log "FAIL: could not move temp file into place"
  log "  $MV_ERR"
  notify "could not write backup: $MV_ERR"
  mark_run fail
  log ""
  exit 1
fi

log "OK: $WINDOWS windows, $TABS tabs -> $(basename "$OUTPUT_FILE")"
mark_run ok
log ""
